              <xs:element name="V_Isca2" type="xs:string" minOccurs="0" maxOccurs="1" />
              <xs:choice>
                <xs:element name="V_Motorista" type="xs:string" minOccurs="0" maxOccurs="1" />
                <xs:element name="V_SenhaMot" type="xs:string" minOccurs="0" maxOccurs="1" />
              </xs:choice>
              <xs:element name="V_CPFMotorista" type="xs:positiveInteger" minOccurs="0" maxOccurs="1" />
              <xs:element name="V_StatusMotorista" type="xs:string" minOccurs="0" maxOccurs="1" />
              <xs:element name="V_CNHMotorista" type="xs:string" minOccurs="0" maxOccurs="1" />
