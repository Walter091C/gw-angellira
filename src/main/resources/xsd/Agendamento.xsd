<?xml version="1.0" encoding="UTF-8"?>
<!-- Contrato fornecido pelo usuário; formatação normalizada. tVersao não é referenciado por Versao (xs:string). -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:simpleType name="tVersao">
    <xs:restriction base="xs:string">
      <xs:pattern value="1.0" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tEmptyNonNegativeInteger">
    <xs:union>
      <xs:simpleType>
        <xs:restriction base="xs:string">
          <xs:length value="0" />
        </xs:restriction>
      </xs:simpleType>
      <xs:simpleType>
        <xs:restriction base="xs:nonNegativeInteger" />
      </xs:simpleType>
    </xs:union>
  </xs:simpleType>
  <xs:simpleType name="tDecPos">
    <xs:restriction base="xs:decimal">
      <xs:minInclusive value="0" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tYesNo">
    <xs:restriction base="xs:string">
      <xs:pattern value="[SN]{1}" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tPlaca">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z]{3}-[0-9]{4}" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tFicticio">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z]{3}0[0-9]{4}" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tCartaoPedagio">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{0,30}" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tTCA">
    <xs:restriction base="xs:string">
      <xs:pattern value="TCA[0-9]{5}" />
    </xs:restriction>
  </xs:simpleType>
  <xs:simpleType name="tVeiculo">
    <xs:union memberTypes="tPlaca tFicticio tTCA " />
  </xs:simpleType>
  <xs:simpleType name="tViagem">
    <xs:restriction base="xs:nonNegativeInteger">
      <xs:minInclusive value="1" />
      <xs:maxInclusive value="4" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="Agendamento">
    <xs:complexType>
