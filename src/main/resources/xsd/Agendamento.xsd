              <xs:element name="V_jornadaMotorista" type="xs:string" minOccurs="0" maxOccurs="1" />
              <xs:element name="V_Volume" type="tDecPos" minOccurs="0" maxOccurs="1" />
              <xs:element name="V_UnidadeMedida" type="xs:string" minOccurs="0" maxOccurs="1" />
              <xs:element name="V_Valor" type="tDecPos" minOccurs="0" maxOccurs="1" />
              <xs:element name="V_Frete" type="tDecPos" minOccurs="0" maxOccurs="1" />
              <xs:element name="V_ProcedimentoEmbarque" type="tEmptyNonNegativeInteger" minOccurs="0" maxOccurs="1" />
