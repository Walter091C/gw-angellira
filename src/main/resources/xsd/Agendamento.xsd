              <xs:element name="V_Origem" type="xs:string" minOccurs="1" maxOccurs="1" />
              <xs:element name="V_Destino" type="xs:string" minOccurs="1" maxOccurs="1" />
              <xs:choice>
                <xs:element name="V_Rota" type="xs:positiveInteger" minOccurs="0" maxOccurs="1" />
                <xs:element name="V_Polilinha" type="xs:string" minOccurs="0" maxOccurs="1" />
              </xs:choice>
              <xs:element name="V_Distancia" type="tDecPos" minOccurs="0" maxOccurs="1" />
              <xs:element name="V_PrevInicio" type="xs:dateTime" minOccurs="1" maxOccurs="1" />
              <xs:element name="V_PrevFim" type="xs:dateTime" minOccurs="0" maxOccurs="1" />
              <xs:element name="V_DataFat" type="xs:dateTime" minOccurs="0" maxOccurs="1" />
              <xs:element name="V_TempoCarga" type="tDecPos" minOccurs="0" maxOccurs="1" />
              <xs:element name="V_TempoDescarga" type="tDecPos" minOccurs="0" maxOccurs="1" />
              <xs:element name="V_EnviarEmail" type="tYesNo" minOccurs="0" maxOccurs="1" />
              <xs:element name="V_EmailsAdicionais" type="xs:string" minOccurs="0" maxOccurs="1" />
              <xs:element name="V_EnviarSMS" type="tYesNo" minOccurs="0" maxOccurs="1" />
              <xs:element name="V_SMSAdicionais" type="xs:string" minOccurs="0" maxOccurs="1" />
              <xs:element name="V_Peso" type="tDecPos" minOccurs="0" maxOccurs="1" />
              <xs:choice>
                <xs:element name="V_Veiculo" type="xs:string" minOccurs="1" maxOccurs="1" />
                <xs:element name="V_Eqpto" type="xs:string" minOccurs="1" maxOccurs="1" />
